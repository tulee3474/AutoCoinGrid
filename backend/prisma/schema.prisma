generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  apiKey        String?  @db.Text
  apiSecret     String?  @db.Text
  scannerActive Boolean  @default(false)
  liveActive    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  strategies    Strategy[]
  paperWallet   PaperWallet?
  livePositions LivePosition[]
  liveTradeLogs LiveTradeLog[]

  @@map("users")
}

model Strategy {
  id         String   @id @default(uuid())
  userId     String
  name       String
  enabled    Boolean  @default(false)
  side       String   @default("SHORT")
  conditions Json
  trade      Json
  coins      Json     @default("[]")
  mlFilter   Json?    // AI 진입 필터 (검증 결과+사용 여부/기준 — 모델 본체는 ml_models). null = 학습 안 함
  mlData     Json?    // AI 학습 데이터 수집 상태 (수집 구간·자동 업데이트 설정). null = 수집 안 함
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mlSamples   MlSample[]
  mlModel     MlModel?
  mlDecisions MlDecision[]

  @@map("strategies")
}

model PaperWallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Float    @default(10000)
  initialBalance Float    @default(10000)
  updatedAt      DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  openPositions PaperPosition[]
  tradeLogs     PaperTradeLog[]

  @@map("paper_wallets")
}

model PaperPosition {
  id              String   @id @default(uuid())
  walletId        String
  symbol          String
  side            String   @default("SHORT")
  entryPrice      Float
  avgEntryPrice   Float    @default(0)
  totalEntryUsdt  Float    @default(0)
  gridsFilled     Int      @default(0)
  gridPrices      Json     @default("[]")
  takeProfitPrice Float
  stopLossPrice   Float
  entryAmountUsdt Float
  leverage        Int
  openedAt        DateTime @default(now())
  expiresAt       DateTime
  strategyName    String

  wallet PaperWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("paper_positions")
}

model PaperTradeLog {
  id              String   @id @default(uuid())
  walletId        String
  symbol          String
  side            String   @default("SHORT")
  entryTime       DateTime
  exitTime        DateTime
  entryPrice      Float
  avgEntryPrice   Float    @default(0)
  exitPrice       Float
  pnlPct          Float
  pnlUsdt         Float
  exitReason      String
  entryAmountUsdt Float
  totalEntryUsdt  Float    @default(0)
  gridsFilled     Int      @default(0)
  leverage        Int
  strategyName    String

  wallet PaperWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("paper_trade_logs")
}

model LivePosition {
  id              String   @id @default(uuid())
  userId          String
  symbol          String
  side            String   @default("SHORT")
  qty             Float
  entryPrice      Float
  avgEntryPrice   Float    @default(0)
  totalEntryUsdt  Float    @default(0)
  gridPrices      Json     @default("[]")
  gridsFilled     Int      @default(0)
  takeProfitPrice Float
  stopLossPrice   Float
  tpOrderId       BigInt?
  slOrderId       BigInt?
  entryAmountUsdt Float
  leverage        Int
  openedAt        DateTime @default(now())
  expiresAt       DateTime
  strategyName    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("live_positions")
}

model AdminPreset {
  id         String   @id @default(uuid())
  type       String   // 'default' | 'recommended'
  name       String
  side       String   @default("SHORT")
  conditions Json
  trade      Json
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("admin_presets")
}

model LiveTradeLog {
  id              String   @id @default(uuid())
  userId          String
  symbol          String
  side            String   @default("SHORT")
  entryTime       DateTime
  exitTime        DateTime
  entryPrice      Float
  exitPrice       Float
  pnlPct          Float
  pnlUsdt         Float
  exitReason      String
  entryAmountUsdt Float
  leverage        Int
  strategyName    String
  fundingFee      Float    @default(0)   // 보유 중 펀딩피 합계 (바이낸스 income, 음수=지불)
  commission      Float    @default(0)   // 진입+청산 수수료 합계 (음수)
  feesSynced      Boolean  @default(false) // 바이낸스 income 조회로 위 두 값이 채워졌는지
  pnlSynced       Boolean  @default(false) // pnlUsdt를 바이낸스 실현손익(REALIZED_PNL)으로 교체했는지

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("live_trade_logs")
}

// AI 진입 필터 학습 데이터 — 거래 1건 = 진입 시점 입력값(features) + 결과(순손익)
// 백테스트로 만든 표본(source=backtest)과 내 실거래 기록으로 만든 표본(source=live)을 누적 저장
model MlSample {
  id          String   @id @default(uuid())
  strategyId  String
  source      String   // 'backtest' | 'live'
  symbol      String
  entryTime   DateTime
  exitTime    DateTime
  features    Json     // FEATURE_NAMES 순서의 숫자 배열
  featureVer  String   // FEATURE_NAMES 해시 — 입력 정의가 바뀌면 옛 표본은 학습에서 제외
  configHash  String   // 백테스트 표본: 수집 당시 전략 설정 해시 / 실거래 표본: ''
  netPnlPct   Float    // 순손익 % (증거금 대비, 수수료+펀딩 반영) — 라벨은 이 값 > 0
  grossPnlPct Float
  marginMult  Float    @default(1)   // 증거금 ÷ 기본 진입금 (그리드 체결 시 1보다 큼) — 금액 기준 계산용
  liveTradeId String?  // 실거래 표본의 원본 LiveTradeLog id
  createdAt   DateTime @default(now())

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([strategyId, source, symbol, entryTime])
  @@index([strategyId, source])
  @@map("ml_samples")
}

// AI 필터 입력값 "시장 분위기" 시계열 — 후보 알트 전체의 24h 수익률 분포 (1시간 단위)
// 백테스트 데이터 수집 때 계산해 저장 → 실거래 표본 변환 시 그 시각 값을 조회
model MlMarketHour {
  hour DateTime @id   // 이 시각에 시작한 1h 캔들 기준
  med  Float          // 24h 수익률 중앙값 (%)
  frac Float          // 24h +10% 이상 비율
  n    Int            // 계산에 쓴 코인 수

  @@map("ml_market_hours")
}

// AI 필터 모델 본체 (트리, 수백 KB~1MB) — 전략 테이블과 분리: 스캐너가 매분 전략을 읽을 때 같이 안 읽히도록.
// 실제 판정이 필요할 때만 읽고 서버 메모리에 캐시 (trainedAt으로 버전 확인)
model MlModel {
  strategyId String   @id
  trainedAt  Float    // MlFilterState.trainedAt (ms)
  model      Json
  updatedAt  DateTime @updatedAt

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@map("ml_models")
}

// AI 판정 기록 — 스캐너가 AI로 판정할 때마다 1건(같은 전략·코인·대상은 4시간에 1번).
// 나중에 "그 시점에 진입했다면?"을 같은 매매 설정으로 시뮬레이션해 AI가 맞았는지 자동 평가
model MlDecision {
  id             String    @id @default(uuid())
  userId         String
  strategyId     String
  strategyName   String
  target         String    // 'paper' | 'live'
  symbol         String
  side           String
  decidedAt      DateTime
  price          Float     // 판정 시점 가격 (= 진입했다면 진입가)
  prob           Float     // AI 점수
  threshold      Float
  pass           Boolean   // true = 통과(진입), false = 차단
  mlTarget       String    // 'profit' | 'avoidLoss' — 맞음/틀림 판단 기준
  lossCutPct     Float?    // avoidLoss: 이 % 이하 순손익 = 큰 손실
  modelTrainedAt Float
  interval       String    // 시뮬레이션 캔들 (전략 타임프레임)
  trade          Json      // 판정 당시 매매 설정 스냅샷
  features       Json      // 판정 당시 AI 입력값 (FEATURE_NAMES 순서, null=결측)
  featureVer     String    @default("")   // 입력값 정의 버전 — 학습에 쓸 때 현재 버전과 같은 것만
  configHash     String    @default("")   // 판정 당시 전략 설정 해시 — 학습에 쓸 때 현재 설정과 같은 것만
  skipReason     String?   // null = 정상 판정 / 'holding' = 이미 같은 코인 보유 중이라 어차피 진입 안 했던 판정 (통계·학습·평가 제외)
  evalStatus     String    @default("pending")   // pending | done | unresolved(30일 넘게 결과 확정 불가)
  evalAt         DateTime?
  simExitPrice   Float?
  simExitTime    DateTime?
  simExitReason  String?   // takeProfit | stopLoss | timeout
  simGrids       Int?
  simNetPnlPct   Float?    // 진입했다면 순손익 % (증거금 대비, 수수료+펀딩)
  simGrossPnlPct Float?
  good           Boolean?  // 결과가 좋은 거래였나 (avoidLoss: 큰 손실 아님 / profit: 순손익 > 0)
  correct        Boolean?  // AI가 맞았나 (통과 & good, 또는 차단 & !good)

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, decidedAt])
  @@index([evalStatus, decidedAt])
  @@map("ml_decisions")
}
