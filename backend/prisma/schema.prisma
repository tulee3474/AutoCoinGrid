generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  apiKey        String?  @db.Text
  apiSecret     String?  @db.Text
  scannerActive Boolean  @default(false)
  liveActive    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  strategies    Strategy[]
  paperWallet   PaperWallet?
  livePositions LivePosition[]
  liveTradeLogs LiveTradeLog[]

  @@map("users")
}

model Strategy {
  id         String   @id @default(uuid())
  userId     String
  name       String
  enabled    Boolean  @default(false)
  side       String   @default("SHORT")
  conditions Json
  trade      Json
  coins      Json     @default("[]")
  mlFilter   Json?    // AI 진입 필터 (모델+검증 결과+사용 여부/기준). null = 학습 안 함
  mlData     Json?    // AI 학습 데이터 수집 상태 (수집 구간·자동 업데이트 설정). null = 수집 안 함
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mlSamples MlSample[]

  @@map("strategies")
}

model PaperWallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Float    @default(10000)
  initialBalance Float    @default(10000)
  updatedAt      DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  openPositions PaperPosition[]
  tradeLogs     PaperTradeLog[]

  @@map("paper_wallets")
}

model PaperPosition {
  id              String   @id @default(uuid())
  walletId        String
  symbol          String
  side            String   @default("SHORT")
  entryPrice      Float
  avgEntryPrice   Float    @default(0)
  totalEntryUsdt  Float    @default(0)
  gridsFilled     Int      @default(0)
  gridPrices      Json     @default("[]")
  takeProfitPrice Float
  stopLossPrice   Float
  entryAmountUsdt Float
  leverage        Int
  openedAt        DateTime @default(now())
  expiresAt       DateTime
  strategyName    String

  wallet PaperWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("paper_positions")
}

model PaperTradeLog {
  id              String   @id @default(uuid())
  walletId        String
  symbol          String
  side            String   @default("SHORT")
  entryTime       DateTime
  exitTime        DateTime
  entryPrice      Float
  avgEntryPrice   Float    @default(0)
  exitPrice       Float
  pnlPct          Float
  pnlUsdt         Float
  exitReason      String
  entryAmountUsdt Float
  totalEntryUsdt  Float    @default(0)
  gridsFilled     Int      @default(0)
  leverage        Int
  strategyName    String

  wallet PaperWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("paper_trade_logs")
}

model LivePosition {
  id              String   @id @default(uuid())
  userId          String
  symbol          String
  side            String   @default("SHORT")
  qty             Float
  entryPrice      Float
  avgEntryPrice   Float    @default(0)
  totalEntryUsdt  Float    @default(0)
  gridPrices      Json     @default("[]")
  gridsFilled     Int      @default(0)
  takeProfitPrice Float
  stopLossPrice   Float
  tpOrderId       BigInt?
  slOrderId       BigInt?
  entryAmountUsdt Float
  leverage        Int
  openedAt        DateTime @default(now())
  expiresAt       DateTime
  strategyName    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("live_positions")
}

model AdminPreset {
  id         String   @id @default(uuid())
  type       String   // 'default' | 'recommended'
  name       String
  side       String   @default("SHORT")
  conditions Json
  trade      Json
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("admin_presets")
}

model LiveTradeLog {
  id              String   @id @default(uuid())
  userId          String
  symbol          String
  side            String   @default("SHORT")
  entryTime       DateTime
  exitTime        DateTime
  entryPrice      Float
  exitPrice       Float
  pnlPct          Float
  pnlUsdt         Float
  exitReason      String
  entryAmountUsdt Float
  leverage        Int
  strategyName    String
  fundingFee      Float    @default(0)   // 보유 중 펀딩피 합계 (바이낸스 income, 음수=지불)
  commission      Float    @default(0)   // 진입+청산 수수료 합계 (음수)
  feesSynced      Boolean  @default(false) // 바이낸스 income 조회로 위 두 값이 채워졌는지

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("live_trade_logs")
}

// AI 진입 필터 학습 데이터 — 거래 1건 = 진입 시점 입력값(features) + 결과(순손익)
// 백테스트로 만든 표본(source=backtest)과 내 실거래 기록으로 만든 표본(source=live)을 누적 저장
model MlSample {
  id          String   @id @default(uuid())
  strategyId  String
  source      String   // 'backtest' | 'live'
  symbol      String
  entryTime   DateTime
  exitTime    DateTime
  features    Json     // FEATURE_NAMES 순서의 숫자 배열
  featureVer  String   // FEATURE_NAMES 해시 — 입력 정의가 바뀌면 옛 표본은 학습에서 제외
  configHash  String   // 백테스트 표본: 수집 당시 전략 설정 해시 / 실거래 표본: ''
  netPnlPct   Float    // 순손익 % (증거금 대비, 수수료+펀딩 반영) — 라벨은 이 값 > 0
  grossPnlPct Float
  liveTradeId String?  // 실거래 표본의 원본 LiveTradeLog id
  createdAt   DateTime @default(now())

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([strategyId, source, symbol, entryTime])
  @@index([strategyId, source])
  @@map("ml_samples")
}

// AI 필터 입력값 "시장 분위기" 시계열 — 후보 알트 전체의 24h 수익률 분포 (1시간 단위)
// 백테스트 데이터 수집 때 계산해 저장 → 실거래 표본 변환 시 그 시각 값을 조회
model MlMarketHour {
  hour DateTime @id   // 이 시각에 시작한 1h 캔들 기준
  med  Float          // 24h 수익률 중앙값 (%)
  frac Float          // 24h +10% 이상 비율
  n    Int            // 계산에 쓴 코인 수

  @@map("ml_market_hours")
}
